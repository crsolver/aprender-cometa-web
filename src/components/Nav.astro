---
import { COMETA_WEB, url } from '../lib/sitio';
import Logo from './Logo.astro';

const enlaces = [
	{ href: url('/#como-funciona'), texto: 'Cómo funciona' },
	{ href: url('/#caracteristicas'), texto: 'Características' },
	{ href: url('/#cursos'), texto: 'Cursos' },
	{ href: url('/#preguntas'), texto: 'Preguntas' },
];
---

<header class="nav">
	<div class="contenedor nav-interior">
		<a href={url('/')} class="nav-logo" aria-label="Cometa aprender, inicio">
			<Logo size={36} /><span class="sufijo">aprender</span>
		</a>
		<nav aria-label="Principal">
			<ul>
				{enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
				<li><a href={COMETA_WEB}>El lenguaje ↗</a></li>
			</ul>
		</nav>
		<a class="boton boton-principal nav-descargar" href={url('/#descargar')}>Descargar</a>
		<details class="menu">
			<summary aria-label="Menú">☰</summary>
			<ul>
				{enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
				<li><a href={COMETA_WEB}>El lenguaje ↗</a></li>
				<li><a href={url('/#descargar')}>Descargar</a></li>
			</ul>
		</details>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(14px);
		background: rgb(36 38 70 / 0.8);
		border-bottom: 1px solid rgb(61 64 112 / 0.6);
	}
	.nav-interior {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 4.2rem;
	}
	.nav-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}
	.sufijo {
		font-family: var(--fuente-codigo);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--turquesa);
		padding-top: 0.2rem;
	}
	ul {
		display: flex;
		gap: 0.3rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ul a {
		color: var(--tinta-suave);
		text-decoration: none;
		font-weight: 500;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		transition: color 0.2s, background 0.2s;
	}
	ul a:hover {
		color: var(--tinta);
		background: rgb(255 255 255 / 0.06);
	}
	.nav-descargar {
		padding: 0.5rem 1.1rem;
		font-size: 0.9rem;
	}
	.menu {
		display: none;
		position: relative;
	}
	.menu summary {
		list-style: none;
		cursor: pointer;
		font-size: 1.4rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--linea);
		border-radius: 10px;
	}
	.menu summary::-webkit-details-marker {
		display: none;
	}
	.menu ul {
		position: absolute;
		right: 0;
		top: 3rem;
		flex-direction: column;
		min-width: 13rem;
		background: var(--noche-2);
		border: 1px solid var(--linea);
		border-radius: 14px;
		padding: 0.5rem;
	}
	@media (max-width: 960px) {
		nav,
		.nav-descargar {
			display: none;
		}
		.menu {
			display: block;
		}
	}
</style>
