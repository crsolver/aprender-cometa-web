---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Courses from '../components/Courses.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
	titulo="Cometa · aprender"
	descripcion="Aprende a programar con Cometa arreglando juegos. Las lecciones traen pruebas, pistas y un editor integrado. Es gratis, está en español y funciona sin conexión."
>
	<Nav />
	<main>
		<Hero />
		<HowItWorks />
		<Features />
		<Courses />
		<Download />
		<Faq />
	</main>
	<Footer />
</Base>
